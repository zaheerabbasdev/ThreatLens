# Copy to .env for local development. Never commit the real .env file.
# The app fails fast at startup if a required variable below is missing —
# see src/config/env.ts.

NODE_ENV=development
PORT=4000

# Comma-separated explicit allowlist — never "*" for an authenticated API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth (added in the next backend increment; present here so the env
# schema fails fast in one place once secrets are required, not scattered
# across whichever module first reads process.env directly) ---
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# --- Database (Phase 5 — not used yet) ---
# MONGODB_URI=

# --- AI provider (Phase 6 — not used yet) ---
# OPENAI_API_KEY=
