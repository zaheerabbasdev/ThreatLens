# Copy to .env for local development. Never commit the real .env file.
# The app fails fast at startup if a required variable below is missing —
# see src/config/env.ts.

NODE_ENV=development
PORT=4000

# Comma-separated explicit allowlist — never "*" for an authenticated API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Database (optional) ---
# Leave unset to run on in-memory repositories (same demo data, no real
# database needed). Set to a real mongodb:// or mongodb+srv:// URI to run
# against MongoDB instead — see backend/README.md's Phase 5 section for the
# one thing that isn't yet verified about that path.
# MONGODB_URI=

# --- AI provider (Phase 6) ---
# Leave unset to run with AI features disabled (routes return a clean 503,
# never fake content — see backend/README.md's Phase 6 section). Set to a
# real key to enable the assistant/incident-analysis/recommendation routes.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_DAILY_REQUEST_LIMIT_PER_ORG=200
